# Signing configuration for release builds.
# Copy this file to keystore.properties (same directory) and fill in real values.
# keystore.properties is git-ignored — NEVER commit it.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore -alias doit -keyalg RSA \
#           -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=CHANGEME
keyAlias=doit
keyPassword=CHANGEME
