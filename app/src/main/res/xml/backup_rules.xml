<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-Backup rules for devices running API 30 and below (ignored on API 31+
    which uses data_extraction_rules.xml instead).

    Same rationale as data_extraction_rules.xml: exclude the SQLCipher database
    and the scheduling guard from cloud backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="injection_prefs.xml" />
</full-backup-content>
