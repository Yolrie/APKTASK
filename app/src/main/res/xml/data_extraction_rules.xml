<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (API 31+).

    The SQLCipher database is encrypted with a device-bound key generated by
    Android Keystore.  Transferring the raw database file to another device or
    to the cloud is useless (the decryption key cannot follow it) and could
    expose metadata, so we exclude it from both cloud backup and device transfer.

    SharedPreferences that contain only non-sensitive UI state (notification
    hours, avatar index, display name) are allowed for cloud backup so that
    the user does not have to re-configure the app after reinstalling.
    The injection-date preference (InjectionPrefs) is excluded because it is
    a local scheduling guard that must reset on a fresh install.
-->
<data-extraction-rules>

    <cloud-backup>
        <!-- Exclude the SQLCipher database — device-bound key, unusable elsewhere -->
        <exclude domain="database" path="." />
        <!-- Exclude the scheduling guard — must reset on fresh install -->
        <exclude domain="sharedpref" path="injection_prefs.xml" />
        <!-- Everything else in sharedpref (profile, notification settings) is fine -->
    </cloud-backup>

    <device-transfer>
        <!-- Exclude the database on device-transfer too: the Keystore key is
             hardware-bound on most devices and will not be transferred. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="injection_prefs.xml" />
    </device-transfer>

</data-extraction-rules>
