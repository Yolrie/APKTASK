<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Task name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_routine_hint"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutineTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Priority -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_routine_priority_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriorityNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriorityLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_low"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriorityMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_medium"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriorityHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_high"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Frequency -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_routine_frequency_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreqDaily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chaque jour"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreqWeekdays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jours ouvrés"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreqWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hebdo"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreqCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personnalisé"
                style="@style/Widget.MaterialComponents.Chip.Choice" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Days (shown only for WEEKLY / CUSTOM) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_routine_days_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDayMon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lun"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDayTue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mar"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDayWed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mer"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDayThu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jeu"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDayFri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ven"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDaySat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sam"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDaySun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dim"
                style="@style/Widget.MaterialComponents.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>
</ScrollView>
